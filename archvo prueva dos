<!-- ===== Modal de inicio de sesión / registro ===== -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <button class="modal-close" id="modalClose">✕</button>
    <div class="modal-tabs">
      <button id="tabLogin" class="active">Iniciar sesión</button>
      <button id="tabRegister">Crear cuenta</button>
    </div>

    <div id="loginPanel">
      <h3>Bienvenido de nuevo</h3>
      <p class="sub">Ingresa a tu cuenta para agendar y hacer seguimiento a tus servicios.</p>
      <form id="loginForm">
        <div class="field"><label for="loginEmail">Correo electrónico</label><input type="email" id="loginEmail" required></div>
        <div class="field"><label for="loginPass">Contraseña</label><input type="password" id="loginPass" required></div>
        <button type="submit" class="btn btn-solid">Iniciar sesión</button>
      </form>
      <p class="form-note">¿Aún no tienes cuenta? <a href="#" id="switchToRegister" style="color:var(--accent-dark); font-weight:700;">Regístrate aquí</a></p>
    </div>

    <div id="registerPanel" style="display:none;">
      <h3>Crea tu cuenta</h3>
      <p class="sub">Regístrate gratis y solicita tu primer servicio en minutos.</p>
      <form id="registerForm">
        <div class="field"><label for="regName">Nombre completo</label><input type="text" id="regName" required></div>
        <div class="field"><label for="regEmail">Correo electrónico</label><input type="email" id="regEmail" required></div>
        <div class="field"><label for="regPass">Contraseña</label><input type="password" id="regPass" required minlength="6"></div>
        <button type="submit" class="btn btn-solid">Crear cuenta</button>
      </form>
      <p class="form-note">¿Ya tienes cuenta? <a href="#" id="switchToLogin" style="color:var(--accent-dark); font-weight:700;">Inicia sesión</a></p>
    </div>

    <div class="form-success" id="formSuccess">
      <div class="check">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h3 id="successTitle">¡Listo!</h3>
      <p class="sub" id="successMsg">Tu cuenta se creó correctamente.</p>
      <button class="btn btn-outline" id="successClose">Cerrar</button>
    </div>
  </div>
</div>

<script>
  // ---------- Datos de ejemplo para el buscador ----------
  const professionals = [
    { name:"Carlos M.", cat:"plomeria", label:"Plomero", rating:"4.9", zone:"A 1.2 km" },
    { name:"Laura T.", cat:"electricidad", label:"Electricista", rating:"4.8", zone:"A 2.1 km" },
    { name:"Andrea P.", cat:"limpieza", label:"Aseo del hogar", rating:"5.0", zone:"A 0.8 km" },
    { name:"Julián R.", cat:"jardin", label:"Jardinero", rating:"4.7", zone:"A 3.0 km" },
    { name:"Sofía G.", cat:"limpieza", label:"Aseo profundo", rating:"4.9", zone:"A 1.6 km" },
    { name:"Esteban V.", cat:"plomeria", label:"Plomero", rating:"4.6", zone:"A 2.4 km" },
  ];

  function initials(name){
    return name.split(" ").map(p=>p[0]).join("").slice(0,2).toUpperCase();
  }

  function renderResults(cat){
    const list = cat === "todos" ? professionals : professionals.filter(p=>p.cat===cat);
    const container = document.getElementById("results");
    container.innerHTML = list.slice(0,4).map(p => `
      <div class="finder-result">
        <div class="avatar">${initials(p.name)}</div>
        <div class="meta"><strong>${p.name}</strong><span>${p.label} · ${p.zone}</span></div>
        <div class="rating">★ ${p.rating}</div>
      </div>
    `).join("");
  }
  renderResults("todos");

  document.getElementById("chips").addEventListener("click", (e)=>{
    const chip = e.target.closest(".chip");
    if(!chip) return;
    document.querySelectorAll(".chip").forEach(c=>c.classList.remove("active"));
    chip.classList.add("active");
    renderResults(chip.dataset.cat);
  });

  // ---------- Animación al hacer scroll ----------
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){ entry.target.classList.add("visible"); }
    });
  }, { threshold:0.12 });
  document.querySelectorAll(".fade-in").forEach(el=>observer.observe(el));

  // ---------- Modal: apertura, cierre y pestañas ----------
  const overlay = document.getElementById("modalOverlay");
  const loginPanel = document.getElementById("loginPanel");
  const registerPanel = document.getElementById("registerPanel");
  const formSuccess = document.getElementById("formSuccess");
  const tabLogin = document.getElementById("tabLogin");
  const tabRegister = document.getElementById("tabRegister");

  function showPanel(which){
    formSuccess.classList.remove("show");
    loginPanel.style.display = which === "login" ? "block" : "none";
    registerPanel.style.display = which === "register" ? "block" : "none";
    tabLogin.classList.toggle("active", which === "login");
    tabRegister.classList.toggle("active", which === "register");
  }

  function openModal(which){
    overlay.classList.add("open");
    showPanel(which);
  }
  function closeModal(){ overlay.classList.remove("open"); }

  [
    ["openLogin","login"], ["openLogin2","login"], ["openLoginFooter","login"],
    ["openRegisterTop","register"], ["openRegister2","register"], ["openRegisterHero","register"],
    ["openRegisterCta","register"], ["openRegisterFooter","register"]
  ].forEach(([id, which])=>{
    const el = document.getElementById(id);
    if(el) el.addEventListener("click", (e)=>{ e.preventDefault(); openModal(which); });
  });

  document.getElementById("modalClose").addEventListener("click", closeModal);
  overlay.addEventListener("click", (e)=>{ if(e.target === overlay) closeModal(); });
  document.addEventListener("keydown", (e)=>{ if(e.key === "Escape") closeModal(); });

  tabLogin.addEventListener("click", ()=>showPanel("login"));
  tabRegister.addEventListener("click", ()=>showPanel("register"));
  document.getElementById("switchToRegister").addEventListener("click",(e)=>{ e.preventDefault(); showPanel("register"); });
  document.getElementById("switchToLogin").addEventListener("click",(e)=>{ e.preventDefault(); showPanel("login"); });

  // ---------- Envío de formularios (demostración en memoria, sin backend) ----------
  document.getElementById("registerForm").addEventListener("submit",(e)=>{
    e.preventDefault();
    document.getElementById("successTitle").textContent = "¡Cuenta creada!";
    document.getElementById("successMsg").textContent = "Bienvenido a Casa Lista. Ya puedes iniciar sesión y solicitar tu primer servicio.";
    loginPanel.style.display = "none";
    registerPanel.style.display = "none";
    formSuccess.classList.add("show");
  });

  document.getElementById("loginForm").addEventListener("submit",(e)=>{
    e.preventDefault();
    document.getElementById("successTitle").textContent = "¡Sesión iniciada!";
    document.getElementById("successMsg").textContent = "Has ingresado correctamente a tu cuenta.";
    loginPanel.style.display = "none";
    registerPanel.style.display = "none";
    formSuccess.classList.add("show");
  });

  document.getElementById("successClose").addEventListener("click", closeModal);
</script>

</body>
